{
  "name": "tabuada-viva",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint && npm run lint:layers",
    "lint:layers": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:trackers": "node scripts/check-no-trackers.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "gen:headers": "node scripts/gen-vercel-headers.mjs",
    "check:headers": "node scripts/gen-vercel-headers.mjs --check",
    "test:db": "node --experimental-strip-types scripts/test-db.mjs",
    "format": "prettier --write .",
    "prepare": "husky",
    "verify": "npm run lint && npm run typecheck && npm test && npm run validate:content && npm run build && npm run check:bundle && npm run check:trackers && npm run check:secrets && npm run check:headers"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "framer-motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.21",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.7.1",
    "fake-indexeddb": "^6.2.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.{ts,tsx,json,css,md}": "prettier --write"
  }
}
