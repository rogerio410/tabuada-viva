# Modelo de variáveis de ambiente. Copie para .env.local (ignorado pelo git) e preencha.
# NUNCA coloque valores reais neste arquivo: ele é versionado.

# --- Testes de banco (npm run test:db), só na sua máquina ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=

# --- Front (Sprint 4). VITE_* vai para o bundle do navegador: só o que é PÚBLICO. ---
# A chave "anon" é pública por desenho (a proteção é o RLS). A chave "service_role" JAMAIS vai para o front,
# para o repositório nem para variáveis VITE_*: ela ignora o RLS. O scanner (npm run check:secrets) barra os dois casos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
